# ─── NEXORA environment ─────────────────────────────────────────
# Copy to .env.local for local development. Never commit real secrets.

# Port for `npm run dev` / `npm start` is set in package.json (3000).

# Simulated provider: fraction of commands that fail with a transient timeout (0–1).
# Useful for exercising retries, rollbacks and failure notifications.
NEXORA_SIM_FAILURE_RATE=0

# Set to 1 to disable the in-process scheduler (e.g. when a separate worker runs it).
NEXORA_DISABLE_SCHEDULER=0

# ─── Production targets (not required for the demo) ────────────
# PostgreSQL for prisma/schema.prisma
DATABASE_URL=postgresql://nexora:change-me@localhost:5432/nexora
# Redis for BullMQ scheduled jobs, rate limits and sessions
REDIS_URL=redis://localhost:6379
# 32-byte base64 key used to encrypt integration credentials at rest
INTEGRATION_SECRET_KEY=
# MQTT broker used by the local gateway
MQTT_URL=mqtts://broker.local:8883

# Home Assistant credentials are entered per organization in the Integrations screen
# and stored server-side; they are never needed here.

# Demo account (seeded automatically into .data/nexora.json on first start):
#   email:    demo@nexora.app
#   password: NexoraDemo#2026
